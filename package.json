{
  "name": "atproto-tailnet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "build:client": "tsx esbuild.config.ts",
    "dev:client": "tsx esbuild.config.ts --watch",
    "test": "vitest run",
    "reset-device-lock": "tsx --env-file=.env src/scripts/reset-device-lock.ts"
  },
  "dependencies": {
    "@atproto-labs/fetch-node": "^0.2.0",
    "@atproto/crypto": "^0.5.7",
    "@atproto/oauth-client-node": "^0.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "connect-pg-simple": "^10.0.0",
    "dockerode": "^4.0.0",
    "drizzle-kit": "^0.30.0",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.18.0",
    "jose": "^6.2.15",
    "pg": "^8.13.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/dockerode": "^3.3.0",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.24.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
