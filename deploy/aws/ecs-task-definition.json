{
  "_comment": [
    "ECS Fargate task definition for atproto-tailnet.",
    "",
    "LIMITATION: This definition is provided for the web tier only.",
    "It does not run the Rust coordinator, the relay or Caddy. You must",
    "run the coordinator on a host the task can reach, and set",
    "COORDINATOR_URL and the coordinator-api-key secret to match it.",
    "",
    "For full functionality, use the EC2 CloudFormation template instead."
  ],
  "family": "atproto-tailnet",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::ACCOUNT_ID:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::ACCOUNT_ID:role/atproto-tailnet-task-role",
  "containerDefinitions": [
    {
      "name": "app",
      "image": "ACCOUNT_ID.dkr.ecr.REGION.amazonaws.com/atproto-tailnet:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 3000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "PORT", "value": "3000" },
        { "name": "LOG_LEVEL", "value": "info" },
        { "name": "COORDINATOR_URL", "value": "http://COORDINATOR_HOST:9443" }
      ],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:atproto-tailnet/database-url"
        },
        {
          "name": "SESSION_SECRET",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:atproto-tailnet/session-secret"
        },
        {
          "name": "COORDINATOR_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:atproto-tailnet/coordinator-api-key"
        },
        {
          "name": "ATPROTO_PRIVATE_KEY",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:atproto-tailnet/atproto-private-key"
        }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "wget -qO- http://localhost:3000/health || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 30
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/atproto-tailnet",
          "awslogs-region": "REGION",
          "awslogs-stream-prefix": "app"
        }
      }
    }
  ]
}
