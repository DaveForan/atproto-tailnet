# Used by docker-compose.production.yml. Replace the two example domains with
# your own; BASE_DOMAIN in .env must match the wildcard (without the "*.").
{
	admin 0.0.0.0:2019

	# The service adds tenant routes to this server through the admin API
	# (src/orchestrator/caddy.ts), so it needs a fixed name.
	servers :443 {
		name tailnet_proxy
	}
}

# Main app — handles dashboard, auth, API
tailnets.example.com {
	reverse_proxy app:3000
}

# Wildcard for tenant subdomains. This block only obtains the wildcard
# certificate (DNS-01 via Cloudflare — needs the Caddy build in
# Dockerfile.caddy and CF_API_TOKEN). The per-tenant reverse proxies are
# managed by the service and matched before this block; a name with no tenant
# gets a 404 from there.
*.ts.example.com {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}
}
