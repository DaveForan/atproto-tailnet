{
	admin 0.0.0.0:2019
}

# Main app — handles dashboard, auth, API
tailnets.example.com {
	reverse_proxy localhost:3000
}

# Wildcard for tenant subdomains — Caddy auto-provisions TLS via Let's Encrypt
# Individual tenant routes are added/removed dynamically via the admin API
# at /config/apps/http/servers/tailnet_proxy/routes
*.ts.example.com {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}
}
