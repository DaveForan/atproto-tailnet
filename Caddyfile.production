# Unified production Caddyfile — TLS strategy is chosen at deploy time by
# mounting a strategy directory at /etc/caddy/tls-strategy/.
#
# Each strategy directory contains:
#   global.caddy — lines for the global options block (may be empty/comments-only)
#   site.caddy   — the tls block for the wildcard site
#
# Available strategies are in caddy/tls-strategies/. To select one, mount it:
#   volumes:
#     - ./caddy/tls-strategies/on-demand:/etc/caddy/tls-strategy:ro
#
# See caddy/tls-strategies/ for the full list and per-strategy documentation.
{
	admin 0.0.0.0:2019

	servers :443 {
		name tailnet_proxy
	}

	import /etc/caddy/tls-strategy/global.caddy
}

# Main app — dashboard, auth, API
{$APP_DOMAIN:tailnets.example.com} {
	reverse_proxy app:3000
}

# Wildcard for tenant subdomains. Per-tenant reverse proxies are managed
# dynamically by the TS service via the Caddy admin API; unmatched names
# fall through to a 404.
*.{$BASE_DOMAIN:ts.example.com} {
	import /etc/caddy/tls-strategy/site.caddy
}
