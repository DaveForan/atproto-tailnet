# atproto-tailnet — coordinator mode
# Copy to .env and fill in secrets before running:
#   docker compose -f docker-compose.coordinator.yml up -d

# ── Database (shared by TS service and coordinator) ──
POSTGRES_USER=atproto_tailnet
POSTGRES_PASSWORD=change-me
POSTGRES_DB=atproto_tailnet
DATABASE_URL=postgresql://atproto_tailnet:change-me@postgres:5432/atproto_tailnet

# ── TS service ──
SESSION_SECRET=change-me-at-least-32-chars-long-for-production
PORT=3000
PUBLIC_URL=https://tailnets.example.com
BASE_DOMAIN=ts.example.com
# Shared control URL host for every tailnet's devices (needs its own DNS A record;
# must NOT be under BASE_DOMAIN). Unset = per-tailnet URLs under BASE_DOMAIN.
# CONTROL_DOMAIN=control.example.com
# Built-in DERP relay host (needs a DNS A record and UDP 3478 open for STUN).
# Unset = no relay: devices that cannot connect directly will not reach each other.
# DERP_DOMAIN=derp.example.com
LOG_LEVEL=info
# ATPROTO_PRIVATE_KEY=  # Generate with: openssl ecparam -name prime256v1 -genkey -noout | openssl pkcs8 -topk8 -nocrypt
# FEDERATION_KEY_ENCRYPTION_KEY=  # 64 hex chars: openssl rand -hex 32

# ── Coordinator connection (tells TS service to use coordinator mode) ──
COORDINATOR_URL=http://coordinator:9443
COORDINATOR_API_KEY=change-me-generate-with-openssl-rand-hex-32

# ── Coordinator process ──
COORD_LISTEN=0.0.0.0:9443
COORD_ADMIN_KEY=${COORDINATOR_API_KEY}
# COORD_DERP_MAP=  # Path to custom DERP map JSON (optional)

# ── Caddy ──
CADDY_ADMIN_URL=http://10.250.250.2:2019

# ── TLS strategy ──
# Selects how Caddy obtains tenant wildcard certificates.
# Available: on-demand, cloudflare, route53, digitalocean, rfc2136, acmedns, hetzner, vultr, manual
# See caddy/tls-strategies/ for per-strategy docs and required env vars.
TLS_STRATEGY=on-demand
# APP_DOMAIN=tailnets.example.com

# DNS-01 provider credentials (set whichever your strategy needs):
# CF_API_TOKEN=
# CADDY_DNS_PLUGINS=github.com/caddy-dns/cloudflare

# ── Tenant public port (leave unset for production with Caddy on 443) ──
# TENANT_PUBLIC_PORT=8180

# ── Notification webhooks ──
# Tenant admins may configure a webhook (self-hosted ntfy, Gotify, a Matrix
# bridge…) that receives every dashboard notification. By default targets must
# be https:// and resolve to public addresses. Set to true ONLY for
# single-organisation self-hosting where the receiver is on your private
# network — it lets any tenant admin make the service POST to internal hosts.
# WEBHOOK_ALLOW_PRIVATE=false

# Federation (links between separate tailnets). Off until its data plane works
# without Docker; turning it on today shows the UI but links carry no traffic.
# FEDERATION_ENABLED=false

# ── Instance operators ──
# Comma-separated DIDs (did:plc:… / did:web:…) of the instance operators.
# Only operators — and the "tailnet creators" they designate — get a tailnet;
# anyone else who signs in sees only their invitations or can request to join
# the default tailnet. Required in production (a loud warning is logged when empty).
# OPERATOR_DIDS=did:plc:your-own-did
