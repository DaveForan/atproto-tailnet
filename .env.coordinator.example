# atproto-tailnet — coordinator mode
# Copy to .env and fill in secrets before running:
#   docker compose -f docker-compose.coordinator.yml up -d

# ── Database (shared by TS service and coordinator) ──
POSTGRES_USER=atproto_tailnet
POSTGRES_PASSWORD=change-me
POSTGRES_DB=atproto_tailnet
DATABASE_URL=postgresql://atproto_tailnet:change-me@postgres:5432/atproto_tailnet

# ── TS service ──
SESSION_SECRET=change-me-at-least-32-chars-long-for-production
PORT=3000
PUBLIC_URL=https://tailnets.example.com
BASE_DOMAIN=ts.example.com
LOG_LEVEL=info
# ATPROTO_PRIVATE_KEY=  # Generate with: openssl ecparam -name prime256v1 -genkey -noout | openssl pkcs8 -topk8 -nocrypt
# FEDERATION_KEY_ENCRYPTION_KEY=  # 64 hex chars: openssl rand -hex 32

# ── Coordinator connection (tells TS service to use coordinator mode) ──
COORDINATOR_URL=http://coordinator:9443
COORDINATOR_API_KEY=change-me-generate-with-openssl-rand-hex-32

# ── Coordinator process ──
COORD_LISTEN=0.0.0.0:9443
COORD_ADMIN_KEY=${COORDINATOR_API_KEY}
# COORD_DERP_MAP=  # Path to custom DERP map JSON (optional)

# ── Caddy ──
CADDY_ADMIN_URL=http://caddy:2019
# CF_API_TOKEN=  # Cloudflare API token for wildcard TLS (production only)

# ── Tenant public port (leave unset for production with Caddy on 443) ──
# TENANT_PUBLIC_PORT=8180
