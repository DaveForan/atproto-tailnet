# Database
DATABASE_URL=postgresql://atproto_tailnet:atproto_tailnet@localhost:5432/atproto_tailnet

# Session
SESSION_SECRET=change-me-in-production

# Service
PORT=3000
# Use the loopback IP, not "localhost": AT Proto OAuth redirects loopback
# clients to an IP literal, and the session cookie must be on the same host.
PUBLIC_URL=http://127.0.0.1:3000
BASE_DOMAIN=ts.localhost
# Port devices use for tenant URLs (http://<slug>.ts.localhost:8180). Needed
# locally because docker-compose.yml publishes Caddy on 8180; leave unset in
# production, where Caddy is on 80/443.
TENANT_PUBLIC_PORT=8180

# Headscale
HEADSCALE_IMAGE=headscale/headscale:0.29.1
HEADSCALE_PORT_RANGE_START=10001
HEADSCALE_PORT_RANGE_END=10100
HEADSCALE_DATA_DIR=./data/headscale
# Docker network shared by Caddy and tenant containers (created by
# docker compose). Unset only if Caddy runs directly on the host.
HEADSCALE_NETWORK=atproto-tailnet-tenants

# Caddy
CADDY_ADMIN_URL=http://localhost:2019

# Logging
LOG_LEVEL=info

# AT Proto OAuth (production only)
# ATPROTO_PRIVATE_KEY=<ES256 JWK>

# Federation (ADR-0016): encrypts collective DID private keys at rest.
# Without it keys are stored unencrypted — set this in production.
# FEDERATION_KEY_ENCRYPTION_KEY=<64 hex chars, e.g. `openssl rand -hex 32`>

# ── Coordinator mode (ADR-0023) ──
# When set, replaces per-tenant Headscale containers with the shared Rust
# coordinator. No Docker socket needed. See docker-compose.coordinator.dev.yml.
# COORDINATOR_URL=http://localhost:9443
# COORDINATOR_API_KEY=dev-coordinator-key
