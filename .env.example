# Database
DATABASE_URL=postgresql://atproto_tailnet:atproto_tailnet@localhost:5432/atproto_tailnet

# Session
SESSION_SECRET=change-me-in-production

# Service
PORT=3000
# Use the loopback IP, not "localhost": AT Proto OAuth redirects loopback
# clients to an IP literal, and the session cookie must be on the same host.
PUBLIC_URL=http://127.0.0.1:3000
BASE_DOMAIN=ts.localhost
# Port devices use for tenant URLs (http://<name>.ts.localhost:8180). Needed
# locally because docker-compose.coordinator.dev.yml publishes Caddy on 8180;
# leave unset in production, where Caddy is on 80/443.
TENANT_PUBLIC_PORT=8180

# Coordinator (required: the service refuses to start without both).
# These values match docker-compose.coordinator.dev.yml.
COORDINATOR_URL=http://localhost:9443
COORDINATOR_API_KEY=dev-coordinator-key-local-only-0000000000

# Caddy
CADDY_ADMIN_URL=http://localhost:2019

# Logging
LOG_LEVEL=info

# AT Proto OAuth (production only)
# ATPROTO_PRIVATE_KEY=<ES256 JWK>

# Federation: encrypts collective DID private keys at rest.
# Without it keys are stored unencrypted — set this in production.
# FEDERATION_KEY_ENCRYPTION_KEY=<64 hex chars, e.g. `openssl rand -hex 32`>

# ── TLS strategy ──
# Selects how Caddy obtains tenant wildcard certificates.
# Available strategies (see caddy/tls-strategies/ for details):
#   on-demand    — per-tenant certs, no DNS credentials (default)
#   cloudflare   — DNS-01 wildcard via Cloudflare
#   route53      — DNS-01 wildcard via AWS Route53
#   digitalocean — DNS-01 wildcard via DigitalOcean
#   rfc2136      — DNS-01 wildcard via RFC 2136 dynamic DNS (BIND/Knot/PowerDNS)
#   acmedns      — DNS-01 wildcard via acme-dns challenge delegation
#   hetzner      — DNS-01 wildcard via Hetzner DNS
#   vultr        — DNS-01 wildcard via Vultr
#   manual       — bring your own wildcard cert + key
TLS_STRATEGY=on-demand

# Domain names used in Caddyfile (env substitution)
# APP_DOMAIN=tailnets.example.com

# DNS-01 provider credentials (set whichever your strategy needs):
# CF_API_TOKEN=                   # cloudflare
# DO_AUTH_TOKEN=                  # digitalocean
# AWS_REGION=                     # route53
# AWS_ACCESS_KEY_ID=              # route53
# AWS_SECRET_ACCESS_KEY=          # route53
# RFC2136_SERVER=                 # rfc2136 (ip:port)
# RFC2136_KEY_NAME=               # rfc2136
# RFC2136_KEY=                    # rfc2136 (base64)
# ACMEDNS_SERVER_URL=             # acmedns
# ACMEDNS_USERNAME=               # acmedns
# ACMEDNS_PASSWORD=               # acmedns
# ACMEDNS_SUBDOMAIN=              # acmedns
# HETZNER_API_TOKEN=              # hetzner
# VULTR_API_KEY=                  # vultr

# If your strategy needs a DNS module, build Caddy with it:
# CADDY_DNS_PLUGINS=github.com/caddy-dns/route53

# ── Notification webhooks ──
# Tenant admins may configure a webhook (self-hosted ntfy, Gotify, a Matrix
# bridge…) that receives every dashboard notification. By default targets must
# be https:// and resolve to public addresses. Set to true ONLY for
# single-organisation self-hosting where the receiver is on your private
# network — it lets any tenant admin make the service POST to internal hosts.
# WEBHOOK_ALLOW_PRIVATE=false

# Federation (links between separate tailnets). Off until its data plane works
# without Docker; turning it on today shows the UI but links carry no traffic.
# Only a federating instance needs the Docker socket (relay containers) and
# FEDERATION_RELAY_NETWORK (the Docker network those containers join).
# FEDERATION_ENABLED=false
# FEDERATION_RELAY_NETWORK=

# ── Instance operators ──
# Comma-separated DIDs (did:plc:… / did:web:…) of the instance operators.
# Only operators — and the "tailnet creators" they designate — get a tailnet;
# anyone else who signs in sees only their invitations or can request to join
# the default tailnet. Required in production (a loud warning is logged when empty).
# OPERATOR_DIDS=did:plc:your-own-did
