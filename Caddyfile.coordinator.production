# Coordinator-mode production Caddyfile — same TLS strategy mechanism as
# Caddyfile.production. Mount a strategy directory at /etc/caddy/tls-strategy/.
# See caddy/tls-strategies/ for available strategies.
{
	# Set per deployment; docker-compose.coordinator.yml binds it to the
	# private caddy_admin network so only the app can reach it.
	admin {$CADDY_ADMIN_LISTEN:0.0.0.0:2019}

	servers :443 {
		name tailnet_proxy
	}

	import /etc/caddy/tls-strategy/global.caddy
}

{$APP_DOMAIN:tailnets.example.com} {
	header Strict-Transport-Security "max-age=31536000"
	# Internal endpoints (on-demand TLS ask) are reached on the private network only.
	@internal path /internal/*
	respond @internal 404
	reverse_proxy app:3000
}

*.{$BASE_DOMAIN:ts.example.com} {
	import /etc/caddy/tls-strategy/site.caddy
}

# Shared control URL (ADR-0026): every tailnet's devices use this one host; the
# pre-auth key alone selects the tailnet. Only the paths Tailscale clients need
# reach the coordinator (its admin API is on the same port). Must not be under
# BASE_DOMAIN. Unset → control.localhost (internal certificate, no ACME).
{$CONTROL_DOMAIN:control.localhost} {
	header Strict-Transport-Security "max-age=31536000"
	@control path /key /ts2021
	handle @control {
		reverse_proxy {$COORDINATOR_UPSTREAM:coordinator:9443}
	}
	handle {
		respond "Not found" 404
	}
}
