# Coordinator-mode production Caddyfile — same TLS strategy mechanism as
# Caddyfile.production. Mount a strategy directory at /etc/caddy/tls-strategy/.
# See caddy/tls-strategies/ for available strategies.
{
	admin 0.0.0.0:2019

	servers :443 {
		name tailnet_proxy
	}

	import /etc/caddy/tls-strategy/global.caddy
}

{$APP_DOMAIN:tailnets.example.com} {
	reverse_proxy app:3000
}

*.{$BASE_DOMAIN:ts.example.com} {
	import /etc/caddy/tls-strategy/site.caddy
}
