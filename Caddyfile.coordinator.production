# Production Caddyfile. The TLS strategy is chosen at deploy time: mount a
# strategy directory at /etc/caddy/tls-strategy/ (global.caddy + site.caddy).
# See caddy/tls-strategies/ for available strategies.
{
	# Set per deployment; docker-compose.coordinator.yml binds it to the
	# private caddy_admin network so only the app can reach it.
	admin {$CADDY_ADMIN_LISTEN:0.0.0.0:2019}

	servers :443 {
		name tailnet_proxy
	}

	import /etc/caddy/tls-strategy/global.caddy
}

{$APP_DOMAIN:tailnets.example.com} {
	header Strict-Transport-Security "max-age=31536000"
	# Internal endpoints (on-demand TLS ask) are reached on the private network only.
	@internal path /internal/*
	respond @internal 404
	reverse_proxy app:3000
}

*.{$BASE_DOMAIN:ts.example.com} {
	import /etc/caddy/tls-strategy/site.caddy
}

# HTTPS service names (ADR-0038). Caddy only obtains this wildcard certificate;
# the gateway serves the names inside tailnets. From the internet a service
# name gets the same 404 as an unknown tailnet name. Must not cover APP_DOMAIN,
# CONTROL_DOMAIN or DERP_DOMAIN.
*.{$SERVICE_DOMAIN:svc.ts.example.com} {
	import /etc/caddy/tls-strategy/site.caddy
	respond "Unknown tailnet" 404
}

# Shared control URL (ADR-0026): every tailnet's devices use this one host; the
# pre-auth key alone selects the tailnet. Only the paths Tailscale clients need
# reach the coordinator (its admin API is on the same port). Must not be under
# BASE_DOMAIN. Unset → control.localhost (internal certificate, no ACME).
{$CONTROL_DOMAIN:control.localhost} {
	header Strict-Transport-Security "max-age=31536000"
	@control path /key /ts2021
	handle @control {
		reverse_proxy {$COORDINATOR_UPSTREAM:coordinator:9443}
	}
	handle {
		respond "Not found" 404
	}
}

# Built-in DERP relay (ADR-0027): encrypted WireGuard packets between devices
# that cannot connect directly. Clients upgrade GET /derp; the other paths are
# their probes. Unset → derp.localhost (internal certificate, no ACME).
{$DERP_DOMAIN:derp.localhost} {
	@derp path /derp /derp/* /generate_204
	handle @derp {
		reverse_proxy {$RELAY_UPSTREAM:coordinator:9443}
	}
	handle {
		respond "Not found" 404
	}
}

# Captive-portal detection uses plain HTTP and must get a 204, not a redirect.
http://{$DERP_DOMAIN:derp.localhost} {
	@probe path /generate_204
	handle @probe {
		reverse_proxy {$RELAY_UPSTREAM:coordinator:9443}
	}
	handle {
		redir https://{host}{uri} 308
	}
}
